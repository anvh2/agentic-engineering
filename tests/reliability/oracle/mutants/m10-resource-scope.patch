+   *
+   * Without `resource` this looks across every resource: a caller that does not know which provider the task used must
+   * see all of them (it may then report a permit of an unrelated run that shares the task id as still engaged, never the
+   * reverse). With `resource` (the caller knows the task's provider) it looks only there, so a permit another run holds on
+   * another provider under the same task id - task ids are unique per plan, not per machine - is not mistaken for this one.
    */
-  engagedBy(tag: string): { kind: 'lease' | 'waiter'; holder: string; pid: number }[] {
+  engagedBy(tag: string, options: { resource?: string } = {}): { kind: 'lease' | 'waiter'; holder: string; pid: number }[] {
     const marker = `:${tag}:pid`;
     const now = this.now();
-    // Across every resource: a cancelled task must have released the permit of whichever provider it was using.
+    const scope = options.resource === undefined ? '' : ' AND resource = ?';
+    const params = options.resource === undefined ? [now] : [now, options.resource];
     // Matched in code, not with LIKE, so task ids containing '_' or '%' cannot match each other.
-    const leases = (this.db.prepare('SELECT holder, pid FROM leases WHERE expires_at > ? ORDER BY acquired_at').all(now) as { holder: string; pid: number }[]).filter((l) => l.holder.includes(marker));
-    const waiters = (this.db.prepare('SELECT holder, pid, tag FROM waiters WHERE expires_at > ? ORDER BY ticket').all(now) as { holder: string; pid: number; tag: string | null }[]).filter((w) => w.tag === tag || w.holder.includes(marker));
+    const leases = (this.db.prepare(`SELECT holder, pid FROM leases WHERE expires_at > ?${scope} ORDER BY acquired_at`).all(...params) as { holder: string; pid: number }[]).filter((l) => l.holder.includes(marker));
+    const waiters = (this.db.prepare(`SELECT holder, pid, tag FROM waiters WHERE expires_at > ?${scope} ORDER BY ticket`).all(...params) as { holder: string; pid: number; tag: string | null }[]).filter((w) => w.tag === tag || w.holder.includes(marker));
     return [...leases.map((l) => ({ kind: 'lease' as const, holder: l.holder, pid: l.pid })), ...waiters.map((w) => ({ kind: 'waiter' as const, holder: w.holder, pid: w.pid }))];
   }
 

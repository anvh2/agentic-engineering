{
  "1": {
    "class_type": "VHS_LoadImagesPath",
    "_meta": { "title": "Load extracted source frames" },
    "inputs": {
      "directory": "{{SOURCE_FRAMES_DIR}}",
      "pattern": "{{FRAME_PATTERN}}",
      "image_load_cap": 0,
      "skip_first_images": 0
    }
  },
  "2": {
    "class_type": "VHS_LoadImagePath",
    "_meta": { "title": "Load character reference image" },
    "inputs": {
      "image": "{{CHARACTER_IMAGE}}",
      "custom_width": 0,
      "custom_height": 0
    }
  },
  "3": {
    "class_type": "VHS_LoadImagePath",
    "_meta": { "title": "Load outfit reference image (optional)" },
    "inputs": {
      "image": "{{OUTFIT_IMAGE}}",
      "custom_width": 0,
      "custom_height": 0
    }
  },
  "4": {
    "class_type": "DWPreprocessor",
    "_meta": { "title": "Extract pose from source frames (motion preservation)" },
    "inputs": {
      "image": ["1", 0],
      "detect_hand": "enable",
      "detect_body": "enable",
      "detect_face": "enable",
      "resolution": 512
    }
  },
  "5": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Base checkpoint (SD1.5-class, replaceable)" },
    "inputs": {
      "ckpt_name": "realisticVisionV60B1.safetensors"
    }
  },
  "6": {
    "class_type": "ADE_AnimateDiffLoaderGen1",
    "_meta": { "title": "AnimateDiff motion module (temporal consistency)" },
    "inputs": {
      "model": ["5", 0],
      "model_name": "mm_sd_v15_v2.ckpt",
      "beta_schedule": "sqrt_linear (AnimateDiff)",
      "context_options": ["17", 0]
    }
  },
  "17": {
    "class_type": "ADE_StandardUniformContextOptions",
    "_meta": { "title": "Sliding context window (mm_sd_v15_v2 caps at 32 frames without one)" },
    "inputs": {
      "context_length": 16,
      "context_stride": 1,
      "context_overlap": 4
    }
  },
  "7": {
    "class_type": "ACN_ControlNetLoaderAdvanced",
    "_meta": { "title": "Pose ControlNet model (Advanced-ControlNet: sliding-context aware, required by AnimateDiff's context window)" },
    "inputs": {
      "cnet": "control_v11p_sd15_openpose.pth"
    }
  },
  "8": {
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": { "title": "IP-Adapter loader (character appearance conditioning)" },
    "inputs": {
      "model": ["6", 0],
      "preset": "PLUS (high strength)"
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive prompt" },
    "inputs": {
      "clip": ["5", 1],
      "text": "{{PROMPT}}, same pose, same camera framing, coherent character, natural lighting"
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative prompt" },
    "inputs": {
      "clip": ["5", 1],
      "text": "extra limbs, distorted face, flicker, inconsistent identity, text, watermark"
    }
  },
  "11": {
    "class_type": "ACN_AdvancedControlNetApply_v2",
    "_meta": { "title": "Apply pose ControlNet (preserves source motion; Advanced-ControlNet, sliding-context aware)" },
    "inputs": {
      "positive": ["9", 0],
      "negative": ["10", 0],
      "control_net": ["7", 0],
      "image": ["4", 0],
      "strength": 1.0,
      "start_percent": 0.0,
      "end_percent": 1.0
    }
  },
  "12": {
    "class_type": "IPAdapterAdvanced",
    "_meta": { "title": "Apply character reference (face/hair/appearance conditioning)" },
    "inputs": {
      "model": ["8", 0],
      "ipadapter": ["8", 1],
      "image": ["2", 0],
      "weight": "{{CHARACTER_WEIGHT}}",
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "13": {
    "class_type": "VAEEncode",
    "_meta": { "title": "Encode source frames to latents (img2img base)" },
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["5", 2]
    }
  },
  "14": {
    "class_type": "KSampler",
    "_meta": { "title": "Per-batch diffusion sampler" },
    "inputs": {
      "model": ["12", 0],
      "positive": ["11", 0],
      "negative": ["11", 1],
      "latent_image": ["13", 0],
      "seed": "{{SEED}}",
      "steps": 20,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.55
    }
  },
  "15": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode generated latents to frames" },
    "inputs": {
      "samples": ["14", 0],
      "vae": ["5", 2]
    }
  },
  "16": {
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Reassemble frames into output video" },
    "inputs": {
      "images": ["15", 0],
      "frame_rate": "{{FPS}}",
      "loop_count": 0,
      "filename_prefix": "video-transform",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "pingpong": false,
      "save_output": true
    }
  }
}

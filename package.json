{
  "name": "agentic-engineering",
  "version": "1.0.0",
  "description": "Local-first autonomous software-engineering runtime: an Engineering Lead plans and reviews, a persistent scheduler dispatches tasks to local AI workers in sandboxed worktrees, deterministic verification gates every change.",
  "private": true,
  "scripts": {
    "dev": "mastra dev --dir src/integrations/mastra",
    "build": "mastra build --dir src/integrations/mastra",
    "start": "mastra start",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts' 'tests/**/*.test.ts'",
    "test:smoke-e2e": "node --disable-warning=ExperimentalWarning --test 'tests/smoke-e2e/*.test.ts'",
    "lead": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts",
    "session": "node src/lead/session/cli.ts",
    "bench:go": "node --env-file=.env tests/bench/run.ts",
    "bench:summarize": "node tests/bench/summarize.ts",
    "lead:plan": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts plan",
    "lead:tasks": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts tasks",
    "lead:run": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts run",
    "lead:status": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts status",
    "lead:review": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts review",
    "lead:resume": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts resume",
    "lead:cancel": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead.ts cancel",
    "smoke:codex": "AGENTIC_REAL_PROVIDER_SMOKE=codex node --disable-warning=ExperimentalWarning --test tests/smoke-e2e/codex-scheduler-smoke.test.ts",
    "smoke:codex-http": "node --disable-warning=ExperimentalWarning tests/provider-smoke/run-codex-http-smoke.ts",
    "smoke:gemini-http": "node --disable-warning=ExperimentalWarning tests/provider-smoke/run-gemini-http-smoke.ts",
    "engineering": "node --disable-warning=ExperimentalWarning scripts/engineering.ts",
    "reliability": "node --disable-warning=ExperimentalWarning tests/reliability/run.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.59.0",
    "@mastra/duckdb": "1.6.1",
    "@mastra/libsql": "1.20.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "1.17.0",
    "diff": "^8.0.4",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.25.0",
    "typescript": "^6.0.3"
  }
}

{
  "name": "harness-engineering",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "worker:demo": "node --env-file=.env scripts/demo-coding-worker.ts",
    "bench:go": "node --env-file=.env scripts/bench-go-ladder.ts",
    "bench:summarize": "node scripts/bench-go-summarize.ts",
    "lead:delegate": "node --env-file=.env scripts/lead-delegate.ts",
    "lead:batch": "node --env-file=.env scripts/lead-batch.ts",
    "workflow:demo": "node --env-file=.env scripts/demo-coding-task-workflow.ts",
    "supervisor:demo": "node --env-file=.env scripts/demo-supervisor.ts",
    "write-worker:demo": "node --env-file=.env scripts/demo-write-worker.ts",
    "step16:real-coding-task": "node --env-file=.env scripts/step16-real-coding-task.ts",
    "eshop:real-coding-task": "node --env-file=.env scripts/eshop-real-coding-task.ts",
    "video:transform": "node --env-file=.env scripts/video-transform.ts",
    "video:phase2": "node benchmarks/phase2/build.mjs",
    "video:phase3": "node benchmarks/phase3/compose-review.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "test:integration": "node --test 'src/**/*.itest.ts'",
    "harness": "node src/harness/cli.ts",
    "lead:sched": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts",
    "lead:plan": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts plan",
    "lead:tasks": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts tasks",
    "lead:run": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts run",
    "lead:status": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts status",
    "lead:review": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts review",
    "lead:resume": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts resume",
    "lead:cancel": "node --disable-warning=ExperimentalWarning --env-file=.env scripts/lead-sched.ts cancel"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.59.0",
    "@mastra/duckdb": "1.6.1",
    "@mastra/libsql": "1.20.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "1.17.0",
    "diff": "^8.0.4",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.25.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3"
  }
}

@@ -0,0 +1,20 @@
+import { useEffect, useRef, useState } from 'react';
+
+/** Same-origin read-only Gateway UI; Studio retains navigation, auth and traces. */
+export default function OrganizationPage() {
+  const frame = useRef<HTMLIFrameElement>(null);
+  const [state, setState] = useState<'loading' | 'ready' | 'unavailable'>('loading');
+  useEffect(() => {
+    const receive = (event: MessageEvent) => {
+      if (event.origin === window.location.origin && event.source === frame.current?.contentWindow && event.data?.type === 'organization-ready') setState('ready');
+    };
+    window.addEventListener('message', receive);
+    const timer = window.setTimeout(() => setState(value => value === 'ready' ? value : 'unavailable'), 10000);
+    return () => { window.removeEventListener('message', receive); window.clearTimeout(timer); };
+  }, []);
+  const section = ({ '/runs': 'runs', '/collaboration': 'collaboration', '/usage': 'usage' } as Record<string, string>)[window.location.pathname] ?? 'overview';
+  return <section aria-label="Organization Control Center" className="flex min-h-0 flex-1 flex-col h-full">
+    {state !== 'ready' && <p role="status" className="p-4 text-sm text-neutral-400">{state === 'loading' ? 'Loading Organization…' : 'Organization is unavailable. Enable the read-only Gateway and build its UI.'}</p>}
+    <iframe ref={frame} title="Organization workspace" src={`/organization-app/?section=${section}`} className="w-full flex-1 border-0 min-h-[600px]" />
+  </section>;
+}

ANTHROPIC_API_KEY=

# Local Ollama server used by the coding workers.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b-ctx8192

# Logical workers (tasks in flight at once, default 1, max 3) vs model permits (model calls in flight machine-wide,
# default 1, stored in ~/.agentic-engineering/model-capacity.db the first time it is created). Independent knobs.
# AGENTIC_WORKER_CONCURRENCY=3
# AGENTIC_MODEL_CONCURRENCY=1

# Cumulative time one task may spend queued for a model permit before it fails as capacity_wait_timeout (default 30 min).
# Queue time does not count against the task's active-execution timeout. Set it for both `lead` and `npm run dev`.
# AGENTIC_MODEL_WAIT_BUDGET_MS=1800000

ANTHROPIC_API_KEY=

# Local Ollama server used by the codingWorker agent.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b-ctx8192

# Absolute path to the repository codingWorker is allowed to read for the
# supervisor demo. Optional - omitted or unset falls back to the text-only
# sample task, and codingWorker's repository tools stay inaccessible.
# Ecosystem (Go vs JS) is auto-detected from go.mod/package.json - either kind of repo works.
TARGET_REPOSITORY=/absolute/path/to/a/repository

# Local video transformation pipeline (src/mastra/video/, scripts/video-transform.ts).
# See docs/operations/video-transformation.md for setup. "mock" needs no external service and
# is useful for a dry run of the pipeline plumbing.
VIDEO_AI_BACKEND=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Optional - defaults to the bundled sample workflow template.
# COMFYUI_WORKFLOW_PATH=/absolute/path/to/your-workflow.json
# COMFYUI_TIMEOUT_MS=1200000
# COMFYUI_POLL_INTERVAL_MS=2000
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# VIDEO_WORKDIR=.workdir/video-transform
# VIDEO_MAX_FPS=24
# VIDEO_MAX_DIMENSION=768
# VIDEO_MIN_FREE_DISK_BYTES=524288000
# FFMPEG_TIMEOUT_MS=300000

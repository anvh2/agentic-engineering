 package slug
 
+import (
+	"regexp"
+	"strings"
+)
+
 // Slugify converts s into a URL slug.
 func Slugify(s string) string {
-	return ""
+	s = strings.ToLower(s)
+	re := regexp.MustCompile(`[^a-z0-9]+`)
+	s = re.ReplaceAllString(s, "-")
+	s = strings.Trim(s, "-")
+	return s
 }
